#!/bin/sh
set -eu
if [ "${3:-/}" != / ]; then
  echo 'Vonvon Bot CLI registration requires the startup volume.' >&2
  exit 1
fi
app='/Applications/Vonvon Bot.app'
node="$app/Contents/Resources/runtime/node/bin/node"
registrar="$app/Contents/Resources/cli-registration.cjs"
"$node" "$registrar" install system "$app"
console_user="$(stat -f '%Su' /dev/console)"
if [ "$console_user" != root ] && [ "$console_user" != loginwindow ]; then
  /usr/bin/sudo -H -u "$console_user" "$node" "$registrar" install user "$app"
fi
