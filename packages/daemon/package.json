{
  "name": "@vonvon/daemon",
  "version": "0.7.0",
  "description": "Vonvon Bot daemon",
  "type": "module",
  "bin": {
    "vonvon": "bin/vonvon.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "LICENSE.bridge",
    "LICENSE.paseo",
    "NOTICE",
    "PROVENANCE.md",
    "import-core.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node bin/vonvon.mjs daemon run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.246",
    "@vonvon/client": "0.1.0",
    "@vonvon/protocol": "0.1.0",
    "@larksuiteoapi/node-sdk": "1.71.1",
    "commander": "^12.1.0",
    "cross-spawn": "^7.0.6",
    "ogg-opus-decoder": "^1.7.5",
    "qrcode-terminal": "^0.12.0",
    "qrcode": "1.5.4",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "24.3.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "tsup": "^8.3.5",
    "typescript": "5.8.3",
    "vitest": "5.0.3",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "author": "modelzen",
  "license": "MIT",
  "private": true
}
