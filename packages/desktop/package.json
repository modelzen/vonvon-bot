    "@vonvon/protocol": "0.1.0",
    "electron-updater": "6.8.11",
    "ws": "8.22.0",
    "zod": "4.6.6"
  },
  "main": "dist/main.cjs",
  "devDependencies": {
    "@types/ws": "8.18.2",
    "npm": "11.20.0"
  },
  "license": "Apache-2.0"
}
