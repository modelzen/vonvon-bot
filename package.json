{
  "name": "vonvon-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/protocol",
    "packages/client",
    "packages/daemon",
    "packages/ui",
    "packages/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test scripts/*.test.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "check:daemon-package": "node scripts/check-vonvon-bot-package.mjs",
    "pack:vonvon-bot": "node scripts/pack-vonvon-bot.mjs",
    "version:sync": "node scripts/product-version.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "5.0.3",
    "@types/node": "24.3.0",
    "electron": "44.11.4",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "plist": "3.1.0",
    "npm": "11.21.3"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "license": "Apache-2.0"
}
