+      <Catalog
+        botId={view.scope.botId}
+        backend={view.identity.backend}
+        purpose="project"
+      >
+        {(catalog) => (
+          <Editor
+            title="新会话默认模型"
+            section={model}
+            save={(draft) => save("model", draft, model.revision)}
+            render={(draft, set, disabled) => (
+              <ModelChoice
+                value={draft.selection}
+                onChange={(selection) => set({ selection })}
+                catalog={catalog}
+                disabled={disabled}
+              />
+            )}
+          />
+        )}
+      </Catalog>
+      <SettingsGroup
+        label="响应成员"
+        footer={
+          permission.access.kind === "readonly"
+            ? permission.access.message
+            : "空列表表示所有群成员；Agent 管理员与所有者始终可以使用。"
+        }
+      >
+        {view.members.openIds.map((id) => (
+          <SettingsRow
+            key={id}
+            title={id}
+            trailing={
+              <Button
+                size="sm"
+                disabled={permission.access.kind === "readonly"}
+                onClick={() => void memberAction(id, "absent")}
+              >
+                移除
+              </Button>
+            }
+          />
+        ))}
+        <SettingsRow
+          title="添加成员 Open ID"
+          trailing={
+            <div className="settings-inline-actions">
+              <Text
+                label="成员 Open ID"
+                value={memberId}
+                disabled={permission.access.kind === "readonly"}
+                onChange={setMemberId}
+              />
+              <Button
+                size="sm"
+                disabled={!openIdSchema.safeParse(memberId.trim()).success}
+                onClick={() => void memberAction(memberId.trim(), "present")}
+              >
+                添加
+              </Button>
+            </div>
+          }
+        />
+        {view.members.openIds.length > 0 && (
+          <SettingsRow
+            title="允许所有成员"
+            trailing={
+              <Button
+                size="sm"
+                disabled={permission.access.kind === "readonly"}
+                onClick={async () => {
+                  const reply = await window.bridge.settings({
+                    type: "act",
+                    action: {
+                      kind: "projectAudience",
+                      botId: view.scope.botId,
+                      projectName: view.scope.projectName,
+                      audience: "all",
+                      revision: view.members.revision,
+                    },
+                  });
+                  setNotice(errorText(reply) ?? "已允许所有成员。");
+                  if (reply.kind === "acted" && reply.result.kind === "saved")
+                    await refresh();
+                }}
+              >
+                清空白名单
+              </Button>
+            }
+          />
+        )}
+      </SettingsGroup>
+      <SessionPicker view={view} />
+      <ActionNotice message={notice} />
+    </>
+  );
+}
+function SessionPicker({ view }: { view: ProjectSettingsView }) {
+  const [sessions, setSessions] = useState<
+    Extract<SettingsReply, { kind: "sessions" }>["sessions"]
+  >([]);
+  const [threadId, setThreadId] = useState("");
+  const [error, setError] = useState<string>();
+  useEffect(() => {
+    let active = true;
+    setError(undefined);
+    void window.bridge
+      .settings({
+        type: "sessions",
+        botId: view.scope.botId,
+        projectName: view.scope.projectName,
+      })
+      .then((reply) => {
+        if (!active) return;
+        if (reply.kind === "sessions")
+          setSessions(
+            reply.sessions.filter(
+              (item) => item.chatId === view.identity.chatId,
+            ),
+          );
+        else
+          setError(
+            reply.kind === "refused" ? reply.message : "话题列表暂不可用。",
+          );
+      })
+      .catch((failure: unknown) => {
+        if (active)
+          setError(
+            failure instanceof Error ? failure.message : "话题列表暂不可用。",
+          );
+      });
+    return () => {
+      active = false;
+    };
+  }, [view.scope.botId, view.scope.projectName, view.identity.chatId]);
+  const selected = sessions.find((item) => item.threadId === threadId);
+  return (
+    <SettingsGroup
+      label="话题模型"
+      footer="选择已有话题，下一轮任务使用该话题保存的模型覆盖。"
+    >
+      {error && (
+        <InlineNotice title="话题列表暂不可用" tone="warning">
+          {error}
+        </InlineNotice>
+      )}
+      <SettingsRow
+        title="选择话题"
+        trailing={
+          <select
+            aria-label="选择话题"
+            value={threadId}
+            onChange={(event) => setThreadId(event.target.value)}
+          >
+            <option value="">请选择</option>
+            {sessions.map((item) => (
+              <option key={item.threadId} value={item.threadId}>
+                {item.summary || item.threadId}
+              </option>
+            ))}
+          </select>
+        }
+      />
+      {selected && (
+        <SessionPanel
+          key={selected.threadId}
+          scope={{
+            kind: "session",
+            botId: view.scope.botId,
+            threadId: selected.threadId,
+          }}
+          expectedChatId={view.identity.chatId}
+        />
+      )}
+    </SettingsGroup>
+  );
+}
+function SessionPanel({
+  scope,
+  expectedChatId,
+}: {
+  scope: Extract<SettingsScope, { kind: "session" }>;
+  expectedChatId: string;
+}) {
+  const [view, setView] = useState<SessionSettingsView>();
+  const [error, setError] = useState<string>();
+  async function refresh() {
+    try {
+      const reply = await window.bridge.settings({ type: "read", scope });
+      if (
+        reply.kind === "view" &&
+        isSessionView(reply.view) &&
+        reply.view.identity.chatId === expectedChatId
+      ) {
+        setView(reply.view);
+        setError(undefined);
+      } else
+        setError(
+          reply.kind === "refused"
+            ? reply.message
+            : "话题身份已更改，请重新选择。",
+        );
+    } catch (failure) {
+      setError(
+        failure instanceof Error ? failure.message : "话题设置暂不可用。",
+      );
+    }
+  }
+  useEffect(() => {
+    let active = true;
+    void window.bridge
+      .settings({ type: "read", scope })
+      .then((reply) => {
+        if (!active) return;
+        if (
+          reply.kind === "view" &&
+          isSessionView(reply.view) &&
+          reply.view.identity.chatId === expectedChatId
+        )
+          setView(reply.view);
+        else
+          setError(
+            reply.kind === "refused"
+              ? reply.message
+              : "话题身份已更改，请重新选择。",
+          );
+      })
+      .catch((failure: unknown) => {
+        if (active)
+          setError(
+            failure instanceof Error ? failure.message : "话题设置暂不可用。",
+          );
+      });
+    return () => {
+      active = false;
+    };
+  }, [scope.botId, scope.threadId, expectedChatId]);
+  if (error)
+    return (
+      <InlineNotice title="话题不可编辑" tone="danger">
+        {error}
+      </InlineNotice>
+    );
+  if (!view) return <p>正在读取话题设置…</p>;
+  const model = view.sections.model;
+  return (
+    <>
+      <SettingsRow
+        title="话题身份"
+        value={`${view.identity.backend} · ${view.identity.sessionId}`}
+      />
+      <Catalog
+        botId={scope.botId}
+        backend={view.identity.backend}
+        purpose="session"
+      >
+        {(catalog) => (
+          <Editor
+            title="本话题模型"
+            section={model}
+            save={async (draft) => {
+              const reply = await window.bridge.settings({
+                type: "save",
+                edit: {
+                  scope,
+                  section: "model",
+                  revision: model.revision,
+                  patch: draft,
+                },
+              });
+              if (reply.kind === "saved" && reply.result.kind === "saved")
+                await refresh();
+              return reply;
+            }}
+            render={(draft, set, disabled) => (
+              <ModelChoice
+                value={draft.selection}
+                onChange={(selection) => set({ selection })}
+                catalog={catalog}
+                disabled={disabled}
+              />
+            )}
+          />
+        )}
+      </Catalog>
+    </>
+  );
+}
+function HostPanel({
+  view,
+  refresh,
+}: {
+  view: HostSettingsView;
+  refresh: () => Promise<void>;
+}) {
+  const [choice, setChoice] = useState<{
+    token: string;
+    displayPath: string;
+  }>();
+  const [notice, setNotice] = useState<string>();
+  const execution = view.sections.execution;
+  async function pick() {
+    const reply = await window.bridge.settings({ type: "chooseExecutable" });
+    if (reply.kind === "fileChosen") setChoice(reply.file);
+    else if (reply.kind === "refused") setNotice(reply.message);
+  }
+  async function save() {
+    if (!choice) return;
+    const reply = await window.bridge.settings({
+      type: "saveExecutable",
+      token: choice.token,
+      revision: execution.revision,
+    });
+    setNotice(
+      errorText(reply) ?? "Codex 路径已保存，将在下次 Host 启动时使用。",
+    );
+    if (reply.kind === "saved" && reply.result.kind === "saved") {
+      setChoice(undefined);
+      await refresh();
+    }
+  }
+  async function reset() {
+    const reply = await window.bridge.settings({
+      type: "save",
+      edit: {
+        scope: view.scope,
+        section: "execution",
+        revision: execution.revision,
+        patch: { codexBin: null },
+      },
+    });
+    setNotice(errorText(reply) ?? "Codex 路径已恢复自动检测。");
+    if (reply.kind === "saved" && reply.result.kind === "saved")
+      await refresh();
+  }
+  return (
+    <SettingsGroup
+      label="Codex 可执行文件"
+      footer={
+        execution.access.kind === "readonly"
+          ? execution.access.message
+          : effectText(execution)
+      }
+    >
+      <SettingsRow
+        title="已保存路径"
+        value={execution.stored.codexBin ?? "自动检测"}
+      />
+      <SettingsRow
+        title="当前运行路径"
+        value={view.runtime.codexBin ?? "未知"}
+      />
+      <SettingsRow
+        title="本次所选"
+        value={choice?.displayPath ?? "尚未选择"}
+        trailing={
+          <Button
+            size="sm"
+            disabled={execution.access.kind === "readonly"}
+            onClick={() => void pick()}
+          >
+            选择文件
+          </Button>
+        }
+      />
+      <div className="settings-edit-actions">
+        <Button
+          size="sm"
+          disabled={!choice || execution.access.kind === "readonly"}
+          onClick={() => void save()}
+        >
+          保存路径
+        </Button>
+        <Button
+          size="sm"
+          disabled={
+            execution.stored.codexBin === null ||
+            execution.access.kind === "readonly"
+          }
+          onClick={() => void reset()}
+        >
+          恢复自动检测
+        </Button>
+      </div>
+      <SettingsRow
+        title="未绑定工作目录时的运行后备"
+        value={view.runtime.fallbackCwd}
+      />
+      <ActionNotice message={notice} />
+    </SettingsGroup>
+  );
+}
+export function SettingsPanel({ target }: { target: Target }) {
+  const [view, setView] = useState<SettingsView>();
+  const [error, setError] = useState<string>();
+  async function refresh() {
+    try {
+      const reply = await window.bridge.settings({
+        type: "read",
+        scope: target,
+      });
+      if (
+        reply.kind === "view" &&
+        JSON.stringify(reply.view.scope) === JSON.stringify(target)
+      ) {
+        setView(reply.view);
+        setError(undefined);
+      } else
+        setError(
+          reply.kind === "refused"
+            ? reply.message
+            : "设置身份与当前选择不一致。",
+        );
+    } catch (failure) {
+      setError(
+        failure instanceof Error
+          ? failure.message
+          : "设置暂不可用，请重新读取。",
+      );
+    }
+  }
+  useEffect(() => {
+    let active = true;
+    setView(undefined);
+    setError(undefined);
+    void window.bridge
+      .settings({ type: "read", scope: target })
+      .then((reply) => {
+        if (!active) return;
+        if (
+          reply.kind === "view" &&
+          JSON.stringify(reply.view.scope) === JSON.stringify(target)
+        )
+          setView(reply.view);
+        else
+          setError(
+            reply.kind === "refused"
+              ? reply.message
+              : "设置身份与当前选择不一致。",
+          );
+      })
+      .catch((failure: unknown) => {
+        if (active)
+          setError(
+            failure instanceof Error
+              ? failure.message
+              : "设置暂不可用，请重新读取。",
+          );
+      });
+    return () => {
+      active = false;
+    };
+  }, [JSON.stringify(target)]);
+  if (error)
+    return (
+      <InlineNotice title="设置暂不可用" tone="danger">
+        {error}
+      </InlineNotice>
+    );
+  if (!view)
+    return (
+      <SettingsGroup label="设置">
+        <SettingsRow title="正在读取当前设置…" />
+      </SettingsGroup>
+    );
+  const content = isAgentView(view) ? (
+    <AgentPanel view={view} refresh={refresh} />
+  ) : isProjectView(view) ? (
+    <ProjectPanel view={view} refresh={refresh} />
+  ) : isHostView(view) ? (
+    <HostPanel view={view} refresh={refresh} />
+  ) : null;
+  return (
+    <>
+      <SettingsGroup
+        label="当前设置"
+        action={
+          <Button size="sm" onClick={() => void refresh()}>
+            重新读取
+          </Button>
+        }
+      >
+        <SettingsRow
+          title="配置范围"
+          value={
+            view.scope.kind === "agent"
+              ? "当前 Agent"
+              : view.scope.kind === "project"
+                ? "当前 Agent 在此群"
+                : view.scope.kind === "host"
+                  ? "这台设备"
+                  : "当前话题"
+          }
+        />
+      </SettingsGroup>
+      {content}
+    </>
+  );
+}
+export function membershipSettingsTarget(member: Membership): ProjectScope {
+  return { kind: "project", botId: member.agentId, projectName: member.name };
+}
