+export function registrationUrl(value: string): string {
+  const url = new URL(value);
+  const hosts = new Set([
+    'accounts.feishu.cn',
+    'accounts.larksuite.com',
+    'open.feishu.cn',
+    'open.larksuite.com',
+  ]);
+  const authority = /^https:\/\/([^/?#]+)/i.exec(value)?.[1];
