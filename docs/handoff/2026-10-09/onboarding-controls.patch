+    !hosts.has(url.hostname) ||
+    url.username ||
+    url.password ||
+    url.port ||
+    authority?.toLowerCase() !== url.hostname
+  )
+    throw new CoreError('untrusted-url', '注册链接不是受支持的飞书或 Lark HTTPS 地址。');
+  return url.href;
+}
